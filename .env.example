# Copie pra `.env` e ajuste. docker-compose lê automaticamente.

# ===== Painel web =====
LIBERTHIA_PASSWORD=mudaessa
# Secret pra HMAC dos tokens (vazio = derivado da senha; troque pra invalidar tokens antigos)
LIBERTHIA_SECRET=

# ===== Portas =====
LIBERTHIA_FRONTEND_PORT=8888
BACKEND_PORT=8090
POSTGRES_PORT=5432

# ===== Conexão com o mod (servidor Minecraft) =====
# Cenário 1 — MC na mesma máquina que o docker:
#   - Linux: host.docker.internal funciona com extra_hosts (compose já faz)
#   - Windows/Mac: host.docker.internal resolve nativo
#
# Cenário 2 — MC em outra máquina (ex: backend/front na VPS, MC na sua casa):
#   - Use IP público OU hostname DDNS do servidor MC
#   - Abra porta 25580 TCP no firewall/roteador (port forward) APENAS
#     pro IP da VPS — não exponha pra internet inteira
#   - Exemplo: MOD_HOST=mc.meudominio.com  ou  MOD_HOST=189.45.12.34
MOD_HOST=host.docker.internal
MOD_PORT=25580
# Pegue do chat in-game com /liberthia admin link, ou do arquivo
# {world}/serverconfig/liberthia_admin_url.txt
MOD_TOKEN=

# ===== Postgres =====
POSTGRES_USER=liberthia
POSTGRES_PASSWORD=liberthia
POSTGRES_DB=liberthia
